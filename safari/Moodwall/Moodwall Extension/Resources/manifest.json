{
  "manifest_version": 3,
  "name": "Moodwall",
  "version": "1.0",
  "description": "새 탭을 열 때마다 큐레이션된 무드 사진과 실시간 시계를 보여줍니다.",
  "key": "",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage", "bookmarks", "favicon", "identity"],
  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "https://images.unsplash.com/*",
    "https://www.googleapis.com/*",
    "https://gmail.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "406019483947-802tgq32pfvf03bujued8gatd277g8aa.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly",
      "https://www.googleapis.com/auth/calendar.readonly"
    ]
  }
}
